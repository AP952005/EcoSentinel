# ─── EcoSentinel Environment Configuration ───────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-random-256-bit-secret-key
APP_DEBUG=true
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/ecosentinel.db

# ── Storage ──────────────────────────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
EXPORT_DIR=./data/exports
AUDIO_CACHE_DIR=./data/audio_cache

# ── JWT / Sessions ────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-different-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Rate Limiting ─────────────────────────────────────────────────────────────
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# ── Ollama / Local AI ─────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_FALLBACK_MODEL=gemma3:4b
OLLAMA_TIMEOUT_SECONDS=120

# ── Piper TTS ────────────────────────────────────────────────────────────────
PIPER_ENABLED=false
PIPER_BIN_PATH=piper
PIPER_MODEL_PATH=./data/piper_models/en_US-lessac-medium.onnx
PIPER_VOICE=en_US-lessac-medium
# Fallback: browser speech synthesis
TTS_FALLBACK=browser

# ── Google Earth Engine ───────────────────────────────────────────────────────
EE_ENABLED=false
EE_PROJECT=your-earth-engine-project-id
# EE_SERVICE_ACCOUNT_KEY_FILE=./data/secrets/ee-service-account.json

# ── Map Provider ─────────────────────────────────────────────────────────────
# For development: OpenStreetMap (comply with usage policy)
# For production: configure a proper tile provider
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors | © OpenFreeMap

# ── Demo / Seed Users (development only) ─────────────────────────────────────
SEED_ADMIN_EMAIL=admin@ecosentinel.local
SEED_ADMIN_PASSWORD=change-this-admin-password
SEED_OFFICER_EMAIL=officer@ecosentinel.local
SEED_OFFICER_PASSWORD=change-this-officer-password

# ── Application Mode ──────────────────────────────────────────────────────────
# LIVE | REPLAY | SYNTHETIC
DEFAULT_ANALYSIS_MODE=REPLAY
