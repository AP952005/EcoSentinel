data/ecosentinel.db
data/ecosentinel.db-shm
data/ecosentinel.db-wal
data/uploads/*
!data/uploads/.gitkeep
data/exports/*
!data/exports/.gitkeep
data/audio_cache/*
!data/audio_cache/.gitkeep
data/piper_models/*
!data/piper_models/.gitkeep
data/secrets/

# Alembic generated
backend/alembic/versions/*.pyc

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.idea/
.vscode/settings.json
*.swp
*.swo

