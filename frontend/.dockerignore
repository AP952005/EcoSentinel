# Frontend .dockerignore
# Excludes build artifacts and secrets from Cloud Build context

# Dependencies - installed in image
node_modules/
.pnp/

# Build output - rebuilt inside image
.next/
out/
build/

# Secrets
.env
.env.*
.env.local
.env.production.local

# Test artifacts
coverage/
playwright-report/
test-results/
e2e/

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# TypeScript build info
*.tsbuildinfo
